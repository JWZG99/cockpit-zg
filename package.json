{
  "name": "cockpit-zg",
  "productName": "Cockpit ZG",
  "version": "2.18.4",
  "description": "Projekte, Aufgaben und Arbeitszeit von ZG als Windows-Programm",
  "main": "main.js",
  "author": "Zottele Gallicchio Architekten",
  "private": true,
  "scripts": {
    "start": "python3 build/web-zu-app.py && electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "ch.zg-architekten.cockpit",
    "productName": "Cockpit ZG",
    "files": [
      "main.js",
      "ki.js",
      "buero-update.js",
      "bauten.js",
      "mail.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Cockpit ZG",
      "artifactName": "Cockpit-ZG-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JWZG99",
        "repo": "cockpit-zg",
        "releaseType": "release"
      }
    ]
  }
}
